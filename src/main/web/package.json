    "vite": "7.1.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.9.0",
    "@electron-forge/maker-zip": "7.9.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "electron": "33.2.1",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.2"
  }
