    {
      "id": "summary",
      "type": "DEMO",
      "title": "Resumo",
      "message": "Use o tipo que expressa melhor o valor que seu programa precisa guardar.",
      "contentBlocks": [
        {
          "type": "HEADING",
          "text": "Resumo"
        },
        {
          "type": "PARAGRAPH",
          "text": "Você viu os oito tipos primitivos de Java e o papel de cada grupo. int e double são escolhas comuns para números; char guarda um caractere; boolean expressa uma decisão."
        },
        {
          "type": "LIST",
          "items": [
            "Use byte e short quando um intervalo pequeno é realmente adequado.",
            "Use long para inteiros muito grandes.",
            "Use float ou double para valores decimais.",
            "Use char para um caractere e boolean para uma condição."
          ]
        },
        {
          "type": "CALLOUT",
          "title": "Próximo passo",
          "text": "Ao declarar uma variável, pense primeiro no significado do valor que ela guarda."
        }
