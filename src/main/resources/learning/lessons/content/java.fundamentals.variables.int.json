  "steps": [
    {
      "id": "intro",
      "type": "DEMO",
      "title": "Tipos primitivos",
      "message": "Conheça os valores básicos que Java oferece sem precisar criar objetos.",
      "contentBlocks": [
        {
          "type": "HEADING",
          "text": "Tipos primitivos"
        },
        {
          "type": "PARAGRAPH",
          "text": "Tipos primitivos representam valores simples diretamente na linguagem. Eles são a base para guardar números, caracteres e estados lógicos em um programa Java."
        },
        {
          "type": "LIST",
          "items": [
            "Inteiros: byte, short, int e long.",
            "Decimais: float e double.",
            "Texto de um caractere: char.",
            "Verdadeiro ou falso: boolean."
          ]
        },
        {
          "type": "CALLOUT",
          "title": "Ideia principal",
          "text": "Escolha o tipo pelo significado da informação, não apenas pelo tamanho do número."
        }
      ],
      "presentations": [
