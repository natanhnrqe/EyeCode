                        <include>com/eyecode/ui/web/WebShellSurface.java</include>
                        <include>com/eyecode/ui/web/WebShellWindowControls.java</include>
                        <include>com/eyecode/ui/web/WebShellWorkspaceComposition.java</include>
                        <include>com/eyecode/ui/web/WebShellWorkspaceController.java</include>
                        <include>com/eyecode/ui/web/WebShellWorkspaceRuntime.java</include>
                        <include>com/eyecode/ui/web/learning/MonacoLearningOverlayPayload.java</include>
                        <include>com/eyecode/ui/web/monaco/MonacoModelId.java</include>
                        <include>com/eyecode/workbench/**</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${webshell.mainClass}</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-webshell-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${webshell.dist.dir}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>stage-webshell-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${webshell.dist.dir}/eyecode-webshell.jar"/>
                                <echo file="${webshell.dist.dir}/run-webshell.cmd"
                                      message="@echo off&#10;java -cp &quot;%~dp0eyecode-webshell.jar;%~dp0lib\*&quot; ${webshell.mainClass} %*&#10;"/>
                                <pathconvert property="webshell.dist.files" pathsep="${line.separator}">
                                    <fileset dir="${webshell.dist.dir}">
                                        <include name="*.jar"/>
                                        <include name="*.cmd"/>
                                        <include name="lib/*.jar"/>
                                    </fileset>
                                    <mapper type="flatten"/>
                                </pathconvert>
                                <echo file="${webshell.dist.dir}/MANIFEST.txt"
                                      message="EyeCode WebShell distribution manifest${line.separator}mainClass=${webshell.mainClass}${line.separator}jar=eyecode-webshell.jar${line.separator}files:${line.separator}${webshell.dist.files}${line.separator}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <mainClass>${webshell.mainClass}</mainClass>
                    <classpathScope>runtime</classpathScope>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
