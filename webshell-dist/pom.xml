                        <include>com/eyecode/ui/web/WebShellDiagnosticsController.java</include>
                        <include>com/eyecode/ui/web/WebShellDispatcher.java</include>
                        <include>com/eyecode/ui/web/WebShellDocumentationController.java</include>
                        <include>com/eyecode/ui/web/WebShellDocumentationHost.java</include>
                        <include>com/eyecode/ui/web/WebShellDocumentController.java</include>
                        <include>com/eyecode/ui/web/WebShellEditorViewFactory.java</include>
                        <include>com/eyecode/ui/web/WebShellEnvelope.java</include>
                        <include>com/eyecode/ui/web/WebShellError.java</include>
                        <include>com/eyecode/ui/web/WebShellExecutionController.java</include>
                        <include>com/eyecode/ui/web/WebShellJdtDiagnosticsController.java</include>
                        <include>com/eyecode/ui/web/WebShellLanguageFeatureController.java</include>
                        <include>com/eyecode/ui/web/WebShellLearningController.java</include>
                        <include>com/eyecode/ui/web/WebShellLessonsController.java</include>
                        <include>com/eyecode/ui/web/WebShellMessageHandler.java</include>
                        <include>com/eyecode/ui/web/WebShellMode.java</include>
                        <include>com/eyecode/ui/web/WebShellNativeFileSelection.java</include>
                        <include>com/eyecode/ui/web/WebShellNativeUi.java</include>
                        <include>com/eyecode/ui/web/WebShellNavigationController.java</include>
                        <include>com/eyecode/ui/web/WebShellPayload.java</include>
