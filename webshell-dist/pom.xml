    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <webshell.dist.dir>${project.build.directory}/webshell-dist</webshell.dist.dir>
        <webshell.mainClass>com.eyecode.ui.web.LocalWebShellLauncher</webshell.mainClass>
